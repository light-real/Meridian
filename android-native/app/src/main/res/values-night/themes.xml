<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Meridian" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cs_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/cs_primary</item>
    </style>

    <style name="Theme.Meridian.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cs_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Meridian</item>
    </style>
</resources>